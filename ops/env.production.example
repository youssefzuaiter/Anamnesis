# Copy to .env.production — or let `ops/bootstrap.sh` do it, which also fills in
# the two secrets with random values. .env.production is git-ignored and must
# stay that way; nothing in it should ever be committed or pasted anywhere.

# Used to build DATABASE_URL, so keep it to letters and digits (`openssl rand -hex 24`).
POSTGRES_PASSWORD=

# Signs session cookies. At least 32 characters; changing it signs everyone out.
NEXTAUTH_SECRET=

# Where the app is reached from. Localhost until a reverse proxy exists.
NEXTAUTH_URL=http://localhost:3200

# The host port the app is published on (bound to 127.0.0.1 only).
ANAMNESIS_PORT=3200

# Ollama runs on the host. host.docker.internal is how a container reaches it.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional: a dedicated, otherwise empty account that the post-deploy smoke check
# signs in as, to prove that sessions and the database work together. Create it
# once by registering in the app, give it a long random password, and never use
# it for anything else.
# SMOKE_EMAIL=
# SMOKE_PASSWORD=
