# Copy to .env.production — or let `ops/bootstrap.sh` do it, which also fills in
# the two secrets with random values. .env.production is git-ignored and must
# stay that way; nothing in it should ever be committed or pasted anywhere.

# Used to build DATABASE_URL, so keep it to letters and digits (`openssl rand -hex 24`).
POSTGRES_PASSWORD=

# Signs session cookies. At least 32 characters; changing it signs everyone out.
NEXTAUTH_SECRET=

# Where the app is reached from. Localhost until a reverse proxy exists.
NEXTAUTH_URL=http://localhost:3200

# The host port the app is published on (bound to 127.0.0.1 only).
ANAMNESIS_PORT=3200

# Ollama runs on the host. host.docker.internal is how a container reaches it.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Registration: the first account needs nothing. After it /register is closed,
# unless an invite code of 16 or more characters is set here; then it asks for it.
# Set one only while adding an account (the smoke account below), then remove it
# and run ops/deploy.sh again.
# REGISTRATION_CODE=

# Encrypted off-machine copies of every backup (ops/offsite.sh). Both or neither. OFFSITE_DIR is a folder on
# an external drive, a NAS mount or a synced folder; OFFSITE_RECIPIENT is an age PUBLIC key (age1...). The
# private key is never kept on this machine. See "Off-machine backups" in ops/README.md.
# OFFSITE_DIR=/Volumes/Backup/anamnesis
# OFFSITE_RECIPIENT=age1...

# Error and uptime alerts (ops/watch.mjs). ops/ntfy-setup.sh writes ALERT_TOPIC; the phone subscribes to it on the
# same ntfy server as reminders. Without phone reminders set up there is no server, and alerts only go to
# ops/state/watch.log.
# ALERT_TOPIC=anamnesis-ops-...

# Optional: a dedicated, otherwise empty account that the post-deploy smoke check
# signs in as, to prove that sessions and the database work together. Create it
# once by registering in the app (with REGISTRATION_CODE set for the moment), give
# it a long random password, and never use it for anything else.
# SMOKE_EMAIL=
# SMOKE_PASSWORD=

# The owner's time zone, for "due today" and the morning reminder. ops/ntfy-setup.sh copies the host's.
# TZ=Europe/Istanbul

# Phone reminders through the self-hosted ntfy server (see "Phone reminders" in ops/README.md).
# Written by ops/ntfy-setup.sh; leave them out and reminders stay off. The hashes are single-quoted
# because they contain dollar signs, which Docker Compose would otherwise read as variables.
# NTFY_APP_TOKEN=tk_...                      the app's publish token (32 characters)
# NTFY_APP_PASSWORD_HASH='$2a$10$...'        the app's ntfy account; its password is never used
# NTFY_PHONE_PASSWORD=...                    type this into the ntfy app, user "phone"
# NTFY_PHONE_PASSWORD_HASH='$2a$10$...'
# NTFY_PUBLIC_URL=https://<this-mac>.<tailnet>.ts.net   what the phone subscribes to (after `tailscale serve`)
# NTFY_PORT=2586                             the localhost port ntfy is published on
