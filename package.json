{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "eval": "tsx --conditions=react-server tests/ai/evals.ts",
    "postinstall": "prisma generate",
    "test": "tsx --conditions=react-server --test \"tests/unit/*.test.ts\" && tsx --test \"tests/render/*.test.ts\"",
    "test:integration": "tsx --conditions=react-server --test \"tests/integration/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-mdast": "10.1.2",
    "katex": "^0.19.1",
    "linkedom": "^0.18.15",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.1.2",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "ollama": "^0.6.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6"
  },
  "packageManager": "pnpm@11.11.0"
}
